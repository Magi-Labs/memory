# Existing Supermemory server; the engine must not be publicly exposed.
SUPERMEMORY_URL=http://host.docker.internal:6767
SUPERMEMORY_API_KEY=REPLACE_WITH_ENGINE_KEY
MEMORY_CONTAINER_TAG=personal
PUBLIC_ORIGIN=https://memory.example.com
STATE_DIR=/app/state

# Generate the three login values with scripts/make_login.py.
LOGIN_EMAIL=you@example.com
LOGIN_SALT=REPLACE_WITH_SALT
LOGIN_HASH=REPLACE_WITH_PBKDF2_HASH

# Optional migration of existing bearer credentials. These are SHA-256 hashes.
# Leave empty for a fresh installation and create credentials in the dashboard.
MCP_KEY_SHA256=
MCP_CODEX_KEY_SHA256=
